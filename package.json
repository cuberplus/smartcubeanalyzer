{
  "name": "smartcubeanalyzer",
  "version": "0.1.0",
  "homepage": "https://cuberplus.com/smartcubeanalyzer",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.24.7",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^16.18.57",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.0",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.4",
    "react-chartjs-2": "^5.2.0",
    "react-data-grid": "^7.0.0-beta.46",
    "react-datepicker": "^4.18.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-multi-select-component": "^4.3.4",
    "react-scripts": "5.0.1",
    "react-select": "^5.8.0",
    "react-switch": "^7.0.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error",
      "@typescript-eslint/ban-types": [
        "error",
        {
          "types": {
            "object": "Describe the actual shape, or use Record<K, V>.",
            "{}": "Describe the actual shape, or use Record<K, V>.",
            "Object": "Describe the actual shape, or use Record<K, V>.",
            "Function": "Declare the parameter and return types explicitly."
          },
          "extendDefaults": true
        }
      ],
      "no-restricted-syntax": [
        "error",
        {
          "selector": "TSUnknownKeyword",
          "message": "'unknown' is not a strong type. Declare the actual shape, or use a generic if it varies by caller."
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/jest": "^29.5.14",
    "@types/react-bootstrap": "^0.32.37",
    "@types/react-datepicker": "^4.15.1",
    "gh-pages": "^6.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5"
  },
  "comment_overrides": "react-scripts 5.0.1 pins vulnerable build-time transitive deps and has no newer release. These force patched versions of the leaf packages that cause them. All are build/dev-only and none ship in the production bundle.",
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.5.28",
    "serialize-javascript": "^7.1.1",
    "underscore": "^1.13.8",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "svgo": "^4.1.0",
    "@tootallnate/once": "^2.0.1"
  }
}
